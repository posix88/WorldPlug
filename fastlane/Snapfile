# Drives `bundle exec fastlane capture_screenshots` (see fastlane/Fastfile). Writes raw device
# screenshots into Scripts/screenshots/raw/ — render-all.mjs then composites captions on top of
# these (see Scripts/screenshots/README.md). Requires the WorldPlugUITests target (added for this
# pipeline) and its accessibility identifiers to stay in sync with RootTabView/CountryBrowserRow.

scheme("WorldPlug")

# This framing set targets the App Store's 6.9" iPhone slot. iPad uses a different tab
# presentation and needs its own layout/caption manifest rather than being mixed into this lane.
devices([
  "iPhone 17 Pro Max"
])

languages([
  "en-US",
  "it"
])

output_directory("./Scripts/screenshots/raw")
override_status_bar(true)
concurrent_simulators(false)
derived_data_path(File.expand_path("~/AI_Pod_DerivedData/WorldPlugSnapshots"))
disable_package_automatic_updates(true)
skip_package_repository_fetches(true)
number_of_retries(0)
stop_after_first_error(true)

# Only drive WorldPlugUITests here — excludes WorldPlugTests (unit tests) from the scheme's
# Testables, since capturing screenshots doesn't need them and they'd only slow this down.
only_testing(["WorldPlugUITests"])
