default_platform(:ios)

require "fileutils"
require "shellwords"

# Don't let fastlane overwrite fastlane/README.md with its auto-generated lane docs — it has a
# hand-written setup guide instead (see that file).
skip_docs

def resolved_xcode_path
  override = ENV["VOLTLY_XCODE_PATH"]
  return override unless override.to_s.empty?

  developer_dir = ENV["DEVELOPER_DIR"]
  developer_dir = `xcode-select -p`.strip if developer_dir.to_s.empty?
  File.expand_path("../..", developer_dir)
end

XCODE_PATH = resolved_xcode_path

SCHEME = "WorldPlug"
TEST_DEVICE = ENV["VOLTLY_TEST_DEVICE"] || "iPhone 17 Pro"
BUILD_OUTPUT_DIRECTORY = "./build/fastlane"
FASTLANE_DIRECTORY = Dir.pwd
SCREENSHOT_RAW_DIRECTORY = File.expand_path("../Scripts/screenshots/raw", FASTLANE_DIRECTORY)

platform :ios do
  before_all do
    # Best-effort only — Ruby's own string encoding locks in from the locale at interpreter
    # boot, so mutating ENV here is too late to fix it (unlike DEVELOPER_DIR above, which only
    # subprocesses spawned later ever read). If you see "'\xCA' on US-ASCII" or "xcrun simctl CLI
    # broken", `LANG`/`LC_ALL` must be exported in your shell *before* invoking fastlane — see
    # fastlane/README.md.
    ENV["LANG"] = "en_US.UTF-8"
    ENV["LC_ALL"] = "en_US.UTF-8"
  end

  private_lane :ensure_ios27_sdk do
    developer_dir = "#{XCODE_PATH}/Contents/Developer"
    unless File.directory?(developer_dir)
      UI.user_error!("Xcode not found at #{XCODE_PATH}. Select Xcode 27 with xcode-select or set VOLTLY_XCODE_PATH.")
    end

    ENV["DEVELOPER_DIR"] = developer_dir
    sdk_version = sh("xcrun --sdk iphoneos --show-sdk-version", log: false).strip
    if sdk_version.split(".").first.to_i < 27
      UI.user_error!("Socket Buddy requires the iOS 27 SDK, but #{XCODE_PATH} provides iOS #{sdk_version}.")
    end
  end

  desc "Run the full test suite (WorldPlugTests) on a simulator"
  lane :test do
    ensure_ios27_sdk
    run_tests(
      scheme: SCHEME,
      devices: [TEST_DEVICE],
      only_testing: ["WorldPlugTests"], # excludes WorldPlugUITests (screenshot pipeline) — see :screenshots
      clean: true
    )
  end

  desc "Bump the build number (CURRENT_PROJECT_VERSION) across every target"
  lane :bump_build_number do
    increment_build_number(xcodeproj: "WorldPlug.xcodeproj")
  end

  desc "Archive + export a release .ipa, signed for App Store distribution"
  private_lane :build_release do
    ensure_ios27_sdk
    build_app(
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: BUILD_OUTPUT_DIRECTORY,
      output_name: "Voltly.ipa",
      clean: true,
      # Lets Xcode silently refresh provisioning profiles under automatic signing (the project's
      # current setup — no `match`/manual profiles configured) instead of failing non-interactively.
      xcargs: "-allowProvisioningUpdates"
    )
  end

  # Authenticates to App Store Connect via an API key instead of an Apple ID + password, so pilot/
  # deliver never hit an interactive 2FA prompt. See fastlane/README.md for how to generate the key
  # and which environment variables to set before running `beta` or `release`.
  private_lane :authenticate do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
      in_house: false
    )
  end

  desc "Run tests, bump the build number, and ship a new build to TestFlight"
  lane :beta do
    test
    authenticate
    bump_build_number
    build_release
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: "Automated TestFlight build via fastlane."
    )
  end

  # Shared `deliver` options for `release`, `upload_metadata`, and `upload_screenshots`.
  # skip_app_version_update is intentionally NOT tied to skip_binary_upload (an earlier version of
  # this lane did that and it broke metadata-only pushes on a never-submitted app): with no App
  # Store version ever created yet, deliver has nothing to attach metadata to and dies with a
  # cryptic "No data" deep inside fetch_app_store_review_detail — a known fastlane limitation for
  # a brand new app's very first push (https://github.com/fastlane/fastlane/issues/20538). Leaving
  # this false lets deliver create/target the editable version shell itself, first push or not.
  private_lane :run_deliver do |options|
    upload_to_app_store(
      skip_binary_upload: options[:skip_binary_upload],
      submit_for_review: false,
      automatic_release: false,
      force: true, # skip deliver's interactive "review the diff in your browser" prompt
      skip_metadata: options[:skip_metadata],
      skip_screenshots: options[:skip_screenshots],
      # The in-app purchase's own metadata/pricing is managed separately in App Store Connect
      # (see AppStore/LAUNCH_PLAN.md §1) — this only silences deliver's precheck warning about it.
      precheck_include_in_app_purchases: false
    )
  end

  desc "Run tests, bump the build number, and push a build + metadata + screenshots to App Store Connect"
  desc "Does NOT submit for review by default — flip submit_for_review to true once everything (screenshots, privacy answers, IAP) is confirmed ready in App Store Connect."
  lane :release do
    test
    authenticate
    bump_build_number
    build_release
    run_deliver(skip_binary_upload: false, skip_metadata: false, skip_screenshots: false)
  end

  desc "Push ONLY metadata (name, subtitle, description, keywords, release notes — everything in"
  desc "fastlane/metadata/) to App Store Connect. Does NOT touch screenshots or upload a binary."
  desc "For iterating on copy alone. Run `fastlane upload_screenshots` separately for images."
  lane :upload_metadata do
    authenticate
    run_deliver(skip_binary_upload: true, skip_metadata: false, skip_screenshots: true)
  end

  desc "Push ONLY screenshots (everything in AppStore/Screenshots/) to App Store Connect. Does NOT"
  desc "touch metadata or upload a binary. Run `fastlane render_screenshots` first if the PNGs in"
  desc "AppStore/Screenshots/ are stale — this lane only uploads what's already there."
  lane :upload_screenshots do
    authenticate
    run_deliver(skip_binary_upload: true, skip_metadata: true, skip_screenshots: false)
  end

  desc "Push both metadata and screenshots to App Store Connect WITHOUT building or uploading a"
  desc "new binary. Convenience wrapper around upload_metadata + upload_screenshots for when you"
  desc "want both pushed together (e.g. before a TestFlight review pass)."
  lane :metadata do
    upload_metadata
    upload_screenshots
  end

  desc "Capture and render all App Store screenshots using deterministic DEBUG-only sample data"
  lane :screenshots do
    capture_raw_screenshots
    render_screenshots
  end

  desc "Drive WorldPlugUITests on the simulator via `snapshot` (see fastlane/Snapfile) and refresh"
  desc "Scripts/screenshots/raw/ with fresh captures for every shot the test covers (countries"
  desc "list, country detail sheet, trip check, saved countries). Does NOT capture the label scanner or"
  desc "widget gallery shots (camera + Home Screen widgets aren't automatable via XCUITest) — those"
  desc "still need a manual `xcrun simctl io booted screenshot` capture into raw/."
  desc "Run `fastlane render_screenshots` afterward to composite captions on top of the new raws."
  lane :capture_raw_screenshots do
    ensure_ios27_sdk

    # Maps each `snapshot("...")` call in WorldPlugUITests.swift to the raw filename
    # Scripts/screenshots/captions.json expects for that shot.
    shot_name_to_raw_filename = {
      "01_countries" => "countries_demo.png",
      "02_tripcheck" => "tripcheck_demo.png",
      "03_countrydetail" => "countrydetail_demo.png",
      "05_saved" => "saved_demo.png"
    }

    language_to_locale = {
      "en-US" => "en-US",
      "it" => "it"
    }

    # Snapshot output shares this root with normalized/manual raw captures. Remove only the
    # generated language directories so scanner/widget captures in raw/ survive.
    language_to_locale.keys.each do |language|
      FileUtils.rm_rf(File.join(SCREENSHOT_RAW_DIRECTORY, language))
    end

    capture_screenshots(
      output_directory: SCREENSHOT_RAW_DIRECTORY,
      reinstall_app: true
    )

    language_directories = language_to_locale.keys.to_h do |language|
      [language, File.join(SCREENSHOT_RAW_DIRECTORY, language)]
    end
    missing_captures = language_directories.flat_map do |language, language_dir|
      shot_name_to_raw_filename.keys.filter_map do |snapshot_name|
        matches = Dir.glob(File.join(language_dir, "*-#{snapshot_name}.png"))
        "#{language}/#{snapshot_name}" if matches.empty?
      end
    end

    unless missing_captures.empty?
      UI.user_error!("Snapshot failed to produce required captures: #{missing_captures.uniq.join(", ")}")
    end

    copied = 0
    language_directories.each do |language, language_dir|
      # English becomes the shared flat raw/ fallback; every language also gets its own
      # raw/<locale>/ copy so render-all.mjs always uses the localized app UI.
      is_english = language.start_with?("en")
      locale_key = language_to_locale.fetch(language)

      shot_name_to_raw_filename.each do |snapshot_name, raw_filename|
        match = Dir.glob(File.join(language_dir, "*-#{snapshot_name}.png")).first
        next unless match

        if is_english
          FileUtils.cp(match, File.join(SCREENSHOT_RAW_DIRECTORY, raw_filename))
          copied += 1
        end

        locale_dir = File.join(SCREENSHOT_RAW_DIRECTORY, locale_key)
        FileUtils.mkdir_p(locale_dir)
        FileUtils.cp(match, File.join(locale_dir, raw_filename))
        copied += 1
      end
    end

    UI.user_error!("Snapshot produced no captures.") if copied.zero?
    UI.success("Copied #{copied} fresh capture(s) into Scripts/screenshots/raw/. Run `fastlane render_screenshots` next.")
  end

  desc "Render every shot in Scripts/screenshots/captions.json (from raw captures already in"
  desc "Scripts/screenshots/raw/) and copy the results into AppStore/Screenshots/. Does NOT touch"
  desc "App Store Connect — run `fastlane upload_screenshots` (or `fastlane metadata`/`release`)"
  desc "afterward to upload them."
  desc "Doesn't capture raw screenshots itself: run `fastlane capture_raw_screenshots` first, or add"
  desc "PNGs to raw/ and an entry to captions.json by hand."
  lane :render_screenshots do
    screenshots_dir = File.expand_path("../Scripts/screenshots", __dir__)

    unless Dir.exist?(File.join(screenshots_dir, "node_modules"))
      UI.message("Installing screenshot renderer dependencies (first run only)...")
      sh("cd #{screenshots_dir.shellescape} && PUPPETEER_SKIP_DOWNLOAD=true npm install")
    end

    sh("cd #{screenshots_dir.shellescape} && node render-all.mjs")

    rendered_root = File.join(screenshots_dir, "out")
    destination_root = File.expand_path("../AppStore/Screenshots", __dir__)
    copied = 0

    # AppStore/Screenshots is generated output. Mirror the current render exactly so stale shots
    # or invalid locale folders such as `it-IT` can never survive and be uploaded by deliver.
    Dir.glob(File.join(destination_root, "*")).select { |entry| File.directory?(entry) }.each do |directory|
      FileUtils.rm_rf(directory)
    end

    Dir.glob(File.join(rendered_root, "*")).select { |entry| File.directory?(entry) }.each do |locale_dir|
      locale = File.basename(locale_dir)
      destination = File.join(destination_root, locale)
      FileUtils.mkdir_p(destination)
      Dir.glob(File.join(locale_dir, "*.png")).each do |file|
        FileUtils.cp(file, destination)
        copied += 1
      end
    end

    UI.success("Copied #{copied} screenshot(s) into AppStore/Screenshots/. Run `fastlane upload_screenshots` (or `fastlane metadata`) to upload.")
  end
end
