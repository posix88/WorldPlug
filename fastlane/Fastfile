default_platform(:ios)

require "fileutils"
require "json"
require "shellwords"

# --- Workaround for `deliver` uploading every App Store Connect screenshot
# twice. The observed flow is: "Uploaded ..." for every file, then
# "<file> is missing on App Store Connect.", then a full re-upload — leaving
# two copies of each screenshot in the version.
#
# Cause: `Deliver::UploadScreenshots#verify_local_screenshots_are_uploaded`
# decides whether a local file made it to ASC *only* by matching MD5s against
# the remote `sourceFileChecksum`. fastlane sets that field itself when it
# PATCHes the upload as finished, but ASC frequently hands it back blank on
# the subsequent GET (either permanently, or for a window after the asset has
# already flipped to COMPLETE). A blank checksum matches nothing, so every
# screenshot is declared missing and `retry_upload_screenshots_if_needed`
# fires. The retry then re-runs the *same* checksum comparison for its
# "already uploaded, skip it" test, which also can't match — so it uploads a
# second copy. The retry's "delete anything not COMPLETE" cleanup can't
# remove the first copy either, because that one IS complete. Both survive.
# (https://github.com/fastlane/fastlane/issues/30094)
#
# Fix: when a remote screenshot has no checksum to compare against, fall back
# to identifying it by file name + byte size *within its own screenshot set*.
# Both come straight from the local file at upload time (see
# Spaceship::ConnectAPI::AppScreenshot.create), a set holds at most 10
# screenshots for one locale/device pair, and every file in a set has a
# distinct name — so the pair identifies a screenshot unambiguously here.
# Verification then passes, no retry fires, and nothing is uploaded twice.
# Deliberately does NOT wait for the checksum to show up: when ASC withholds
# it for good, waiting just stalls the lane for `screenshot_processing_timeout`
# (an hour by default) and duplicates anyway.
#
# Safe to delete once fastlane matches screenshots by something other than a
# checksum ASC may never return.
require "deliver/upload_screenshots"

# NOTE: the leading `::` is load-bearing. The Fastfile is eval'd inside a
# binding whose lexical scope is Fastlane::FastFile, so a bare `module
# Deliver` here silently defines Fastlane::FastFile::Deliver — a phantom
# nested module — instead of reopening the real top-level `Deliver` from the
# `deliver` gem. The patch then "looks" applied (source_location shows this
# file) while `upload_to_app_store` keeps calling the original, unpatched
# method and screenshots get duplicated anyway. Confirmed by direct testing:
# without `::`, Fastlane::FastFile.const_defined?(:Deliver) becomes true and
# ::Deliver::UploadScreenshots#verify_local_screenshots_are_uploaded still
# points at the gem file, not here.
module ::Deliver
  class UploadScreenshots
    # Return `true` if all the local screenshots are uploaded to App Store Connect
    def verify_local_screenshots_are_uploaded(iterator, screenshots_per_language)
      # Check if local screenshots' checksum exist on App Store Connect
      checksum_to_app_screenshot = iterator.each_app_screenshot.map { |_, _, app_screenshot| [app_screenshot.source_file_checksum, app_screenshot] }.to_h

      number_of_screenshots_per_set = {}
      missing_local_screenshots = iterator.each_local_screenshot(screenshots_per_language).select do |_, app_screenshot_set, local_screenshot|
        number_of_screenshots_per_set[app_screenshot_set] ||= (app_screenshot_set.app_screenshots || []).count
        checksum = UploadScreenshots.calculate_checksum(local_screenshot.path)

        next(false) if checksum_to_app_screenshot[checksum]

        # No checksum match — before calling it missing, see whether this set
        # already holds a finished screenshot that ASC simply didn't give us a
        # checksum for. Only blank-checksum remotes are eligible: a remote that
        # *did* report a checksum has already been compared above, and matching
        # it by name here would let a genuinely different file pass.
        file_name = File.basename(local_screenshot.path)
        file_size = File.size(local_screenshot.path)
        already_uploaded = (app_screenshot_set.app_screenshots || []).any? do |app_screenshot|
          app_screenshot.complete? &&
            app_screenshot.source_file_checksum.to_s.empty? &&
            app_screenshot.file_name == file_name &&
            app_screenshot.file_size.to_i == file_size
        end

        if already_uploaded
          UI.verbose("#{local_screenshot.path} matched on App Store Connect by file name + size (no checksum reported).")
          next(false)
        end

        is_missing = number_of_screenshots_per_set[app_screenshot_set] < 10 # if it's more than 10, it's skipped
        number_of_screenshots_per_set[app_screenshot_set] += 1
        next(is_missing)
      end

      missing_local_screenshots.each do |_, _, screenshot|
        UI.error("#{screenshot.path} is missing on App Store Connect.")
      end

      missing_local_screenshots.empty?
    end
  end
end

# Fail loudly at parse time if the patch above landed on a phantom class
# instead of the real one, rather than silently duplicating screenshots.
if ::Deliver::UploadScreenshots
   .instance_method(:verify_local_screenshots_are_uploaded)
   .source_location.to_a.first.to_s.include?("/gems/")
  UI.user_error!("Fastfile: the Deliver::UploadScreenshots patch did not take effect — screenshots would be uploaded twice. Check the leading `::` on `module ::Deliver`.")
end

# Don't let fastlane overwrite fastlane/README.md with its auto-generated lane docs — it has a
# hand-written setup guide instead (see that file).
skip_docs

def resolved_xcode_path
  override = ENV["VOLTLY_XCODE_PATH"]
  return override unless override.to_s.empty?

  developer_dir = ENV["DEVELOPER_DIR"]
  developer_dir = `xcode-select -p`.strip if developer_dir.to_s.empty?
  File.expand_path("../..", developer_dir)
end

XCODE_PATH = resolved_xcode_path

SCHEME = "WorldPlug"
TEST_DEVICE = ENV["VOLTLY_TEST_DEVICE"] || "iPhone 17 Pro"
BUILD_OUTPUT_DIRECTORY = "./build/fastlane"
FASTLANE_DIRECTORY = Dir.pwd
SCREENSHOT_RAW_DIRECTORY = File.expand_path("../Scripts/screenshots/raw", FASTLANE_DIRECTORY)

# The Home Screen widget shot (06_widgets) can't go through `snapshot`: XCUITest drives the app
# under test, not SpringBoard, so it can neither open the widget gallery nor place a widget. That
# capture uses a dedicated, long-lived simulator whose Home Screen holds the three Socket Buddy
# widgets — see :prepare_widget_device (one-time, manual) and :capture_widget_screenshots (the
# repeatable part). Everything except placing the widgets that one time is automated.
WIDGET_DEVICE_NAME = ENV["VOLTLY_WIDGET_DEVICE"] || "Voltly Shots 17 Pro Max"
# Must match the device the rest of the pipeline frames for — the App Store's 6.9" iPhone slot,
# 1320x2868 (see fastlane/Snapfile and Scripts/screenshots/captions.json).
WIDGET_DEVICE_TYPE = "com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro-Max"
WIDGET_DEVICE_RUNTIME = "com.apple.CoreSimulator.SimRuntime.iOS-27-0"
WIDGET_RAW_FILENAME = "widgets_demo.png"
WIDGET_DERIVED_DATA = File.expand_path("~/AI_Pod_DerivedData/WorldPlugWidgetShot")
# Set by :prepare_widget_device once a human has confirmed the widgets are on the Home Screen.
# Without it, :capture_widget_screenshots would happily photograph an empty Home Screen.
WIDGET_MARKER_DOMAIN = "com.posix88.Voltly.screenshots"
WIDGET_MARKER_KEY = "widgetsPlaced"
# App language -> App Store Connect locale directory. The locale keys must match
# Scripts/screenshots/captions.json (note: `it`, not `it-IT` — deliver rejects the latter).
WIDGET_LANGUAGES = { "en-US" => "en-US", "it-IT" => "it" }.freeze

platform :ios do
  before_all do
    # Best-effort only — Ruby's own string encoding locks in from the locale at interpreter
    # boot, so mutating ENV here is too late to fix it (unlike DEVELOPER_DIR above, which only
    # subprocesses spawned later ever read). If you see "'\xCA' on US-ASCII" or "xcrun simctl CLI
    # broken", `LANG`/`LC_ALL` must be exported in your shell *before* invoking fastlane — see
    # fastlane/README.md.
    ENV["LANG"] = "en_US.UTF-8"
    ENV["LC_ALL"] = "en_US.UTF-8"
  end

  private_lane :ensure_ios27_sdk do
    developer_dir = "#{XCODE_PATH}/Contents/Developer"
    unless File.directory?(developer_dir)
      UI.user_error!("Xcode not found at #{XCODE_PATH}. Select Xcode 27 with xcode-select or set VOLTLY_XCODE_PATH.")
    end

    ENV["DEVELOPER_DIR"] = developer_dir
    sdk_version = sh("xcrun --sdk iphoneos --show-sdk-version", log: false).strip
    if sdk_version.split(".").first.to_i < 27
      UI.user_error!("Socket Buddy requires the iOS 27 SDK, but #{XCODE_PATH} provides iOS #{sdk_version}.")
    end
  end

  desc "Run the full test suite (WorldPlugTests) on a simulator"
  lane :test do
    ensure_ios27_sdk
    run_tests(
      scheme: SCHEME,
      devices: [TEST_DEVICE],
      only_testing: ["WorldPlugTests"], # excludes WorldPlugUITests (screenshot pipeline) — see :screenshots
      clean: true
    )
  end

  desc "Bump the build number (CURRENT_PROJECT_VERSION) across every target"
  lane :bump_build_number do
    increment_build_number(xcodeproj: "WorldPlug.xcodeproj")
  end

  desc "Bump the marketing version (CFBundleShortVersionString) across every target"
  desc "Usage: fastlane bump_version version:1.2.3"
  desc "Call this once, ahead of a `release` run, whenever that run needs to ship a new"
  desc "marketing version instead of just another build of the current one."
  lane :bump_version do |options|
    version = options[:version]
    UI.user_error!("Version is required. Example: fastlane bump_version version:1.2.3") if version.to_s.empty?

    increment_version_number(
      version_number: version,
      xcodeproj: "WorldPlug.xcodeproj"
    )
  end

  desc "Archive + export a release .ipa, signed for App Store distribution"
  private_lane :build_release do
    ensure_ios27_sdk
    build_app(
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: BUILD_OUTPUT_DIRECTORY,
      output_name: "Voltly.ipa",
      clean: true,
      # Lets Xcode silently refresh provisioning profiles under automatic signing (the project's
      # current setup — no `match`/manual profiles configured) instead of failing non-interactively.
      xcargs: "-allowProvisioningUpdates"
    )
  end

  # Authenticates to App Store Connect via an API key instead of an Apple ID + password, so pilot/
  # deliver never hit an interactive 2FA prompt. See fastlane/README.md for how to generate the key
  # and which environment variables to set before running `beta` or `release`.
  private_lane :authenticate do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_FILEPATH"),
      in_house: false
    )
  end

  desc "Run tests, bump the build number, and ship a new build to TestFlight"
  lane :beta do
    test
    authenticate
    bump_build_number
    build_release
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: "Automated TestFlight build via fastlane."
    )
  end

  # Shared `deliver` options for `release`, `upload_metadata`, and `upload_screenshots`.
  # skip_app_version_update is intentionally NOT tied to skip_binary_upload (an earlier version of
  # this lane did that and it broke metadata-only pushes on a never-submitted app): with no App
  # Store version ever created yet, deliver has nothing to attach metadata to and dies with a
  # cryptic "No data" deep inside fetch_app_store_review_detail — a known fastlane limitation for
  # a brand new app's very first push (https://github.com/fastlane/fastlane/issues/20538). Leaving
  # this false lets deliver create/target the editable version shell itself, first push or not.
  private_lane :run_deliver do |options|
    upload_to_app_store(
      skip_binary_upload: options[:skip_binary_upload],
      submit_for_review: false,
      automatic_release: false,
      force: true, # skip deliver's interactive "review the diff in your browser" prompt
      skip_metadata: options[:skip_metadata],
      skip_screenshots: options[:skip_screenshots],
      # The in-app purchase's own metadata/pricing is managed separately in App Store Connect
      # (see AppStore/LAUNCH_PLAN.md §1) — this only silences deliver's precheck warning about it.
      precheck_include_in_app_purchases: false
    )
  end

  desc "Run tests, bump the build number, and push a build + metadata + screenshots to App Store Connect"
  desc "Does NOT submit for review by default — flip submit_for_review to true once everything (screenshots, privacy answers, IAP) is confirmed ready in App Store Connect."
  lane :release do
    test
    authenticate
    bump_build_number
    build_release
    run_deliver(skip_binary_upload: false, skip_metadata: false, skip_screenshots: false)
  end

  desc "Push ONLY metadata (name, subtitle, description, keywords, release notes — everything in"
  desc "fastlane/metadata/) to App Store Connect. Does NOT touch screenshots or upload a binary."
  desc "For iterating on copy alone. Run `fastlane upload_screenshots` separately for images."
  lane :upload_metadata do
    authenticate
    run_deliver(skip_binary_upload: true, skip_metadata: false, skip_screenshots: true)
  end

  desc "Push ONLY screenshots (everything in AppStore/Screenshots/) to App Store Connect. Does NOT"
  desc "touch metadata or upload a binary. Run `fastlane render_screenshots` first if the PNGs in"
  desc "AppStore/Screenshots/ are stale — this lane only uploads what's already there."
  lane :upload_screenshots do
    authenticate
    run_deliver(skip_binary_upload: true, skip_metadata: true, skip_screenshots: false)
  end

  desc "Push both metadata and screenshots to App Store Connect WITHOUT building or uploading a"
  desc "new binary. Convenience wrapper around upload_metadata + upload_screenshots for when you"
  desc "want both pushed together (e.g. before a TestFlight review pass)."
  lane :metadata do
    upload_metadata
    upload_screenshots
  end

  desc "Capture and render all App Store screenshots using deterministic DEBUG-only sample data"
  desc "The Home Screen widget shot needs a one-off `fastlane prepare_widget_device`; without it"
  desc "that single shot is skipped with a warning and the other five still render."
  lane :screenshots do
    capture_raw_screenshots
    capture_widget_screenshots(optional: true)
    render_screenshots
  end

  desc "Drive WorldPlugUITests on the simulator via `snapshot` (see fastlane/Snapfile) and refresh"
  desc "Scripts/screenshots/raw/ with fresh captures for every shot the test covers (countries"
  desc "list, country detail sheet, trip check, saved countries). Does NOT capture the label scanner"
  desc "shot (the camera isn't automatable via XCUITest) — that one still needs a manual"
  desc "`xcrun simctl io booted screenshot` capture into raw/. The Home Screen widget shot has its"
  desc "own lane: `fastlane capture_widget_screenshots`."
  desc "Run `fastlane render_screenshots` afterward to composite captions on top of the new raws."
  lane :capture_raw_screenshots do
    ensure_ios27_sdk

    # Maps each `snapshot("...")` call in WorldPlugUITests.swift to the raw filename
    # Scripts/screenshots/captions.json expects for that shot.
    shot_name_to_raw_filename = {
      "01_countries" => "countries_demo.png",
      "02_tripcheck" => "tripcheck_demo.png",
      "03_countrydetail" => "countrydetail_demo.png",
      "05_saved" => "saved_demo.png"
    }

    language_to_locale = {
      "en-US" => "en-US",
      "it" => "it"
    }

    # Snapshot output shares this root with normalized/manual raw captures. Remove only the
    # generated language directories so scanner/widget captures in raw/ survive.
    language_to_locale.keys.each do |language|
      FileUtils.rm_rf(File.join(SCREENSHOT_RAW_DIRECTORY, language))
    end

    capture_screenshots(
      output_directory: SCREENSHOT_RAW_DIRECTORY,
      reinstall_app: true
    )

    language_directories = language_to_locale.keys.to_h do |language|
      [language, File.join(SCREENSHOT_RAW_DIRECTORY, language)]
    end
    missing_captures = language_directories.flat_map do |language, language_dir|
      shot_name_to_raw_filename.keys.filter_map do |snapshot_name|
        matches = Dir.glob(File.join(language_dir, "*-#{snapshot_name}.png"))
        "#{language}/#{snapshot_name}" if matches.empty?
      end
    end

    unless missing_captures.empty?
      UI.user_error!("Snapshot failed to produce required captures: #{missing_captures.uniq.join(", ")}")
    end

    copied = 0
    language_directories.each do |language, language_dir|
      # English becomes the shared flat raw/ fallback; every language also gets its own
      # raw/<locale>/ copy so render-all.mjs always uses the localized app UI.
      is_english = language.start_with?("en")
      locale_key = language_to_locale.fetch(language)

      shot_name_to_raw_filename.each do |snapshot_name, raw_filename|
        match = Dir.glob(File.join(language_dir, "*-#{snapshot_name}.png")).first
        next unless match

        if is_english
          FileUtils.cp(match, File.join(SCREENSHOT_RAW_DIRECTORY, raw_filename))
          copied += 1
        end

        locale_dir = File.join(SCREENSHOT_RAW_DIRECTORY, locale_key)
        FileUtils.mkdir_p(locale_dir)
        FileUtils.cp(match, File.join(locale_dir, raw_filename))
        copied += 1
      end
    end

    UI.user_error!("Snapshot produced no captures.") if copied.zero?
    UI.success("Copied #{copied} fresh capture(s) into Scripts/screenshots/raw/. Run `fastlane render_screenshots` next.")
  end

  # --- Home Screen widget shot (06_widgets) ------------------------------------------------
  # Helpers below shell out to simctl rather than using fastlane actions: none of the stock
  # actions can boot a named device, swap its system language, or take a raw device screenshot.

  private_lane :widget_device_udid do
    devices = JSON.parse(sh("xcrun simctl list devices --json", log: false))["devices"]
    match = devices.values.flatten.find { |device| device["name"] == WIDGET_DEVICE_NAME && device["isAvailable"] }
    match && match["udid"]
  end

  # Writes the system language/region into the booted device's global defaults. The caller has to
  # restart the device afterward for SpringBoard and the widget extension to pick it up.
  private_lane :set_device_language do |options|
    udid = options[:udid]
    language = options[:language]
    sh("xcrun simctl spawn #{udid} defaults write 'Apple Global Domain' AppleLanguages -array #{language.shellescape}", log: false)
    sh("xcrun simctl spawn #{udid} defaults write 'Apple Global Domain' AppleLocale -string #{language.tr('-', '_').shellescape}", log: false)
  end

  private_lane :boot_widget_device do |options|
    udid = options[:udid]
    sh("xcrun simctl boot #{udid} || true", log: false)
    # Waits for SpringBoard, so the launch below can't race the boot.
    sh("xcrun simctl bootstatus #{udid} -b", log: false)
  end

  # Launches the app with the same deterministic seed the UI tests use and waits until it has
  # mirrored the values into the App Group. The widgets read that suite directly, so capturing
  # before the mirror lands photographs empty widgets — it takes ~15s on a first launch.
  private_lane :seed_widget_device do |options|
    udid = options[:udid]
    # Terminate the app if it's already running (from a previous failed attempt)
    sh("xcrun simctl terminate #{udid} com.posix88.Voltly || true", log: false)
    sleep(1)
    sh("xcrun simctl launch #{udid} com.posix88.Voltly -FASTLANE_SNAPSHOT YES", log: false)

    container = sh("xcrun simctl get_app_container #{udid} com.posix88.Voltly groups", log: false)
      .lines.map(&:strip).find { |line| line.include?("group.com.posix88.Voltly") }
      &.split(/\s+/)&.last
    UI.user_error!("Could not resolve the App Group container on #{WIDGET_DEVICE_NAME}.") if container.to_s.empty?

    plist = File.join(container, "Library/Preferences/group.com.posix88.Voltly.plist")
    required = ["home.country.code", "favorite.country.code", "next.trip.country.code"]
    deadline = Time.now + 90
    until Time.now > deadline
      if File.exist?(plist)
        dump = sh("plutil -p #{plist.shellescape}", log: false)
        break if required.all? { |key| dump.include?(key) }
      end
      sleep(2)
    end

    unless File.exist?(plist) && required.all? { |key| sh("plutil -p #{plist.shellescape}", log: false).include?(key) }
      UI.user_error!("#{WIDGET_DEVICE_NAME} never wrote the App Group widget values — the widgets would render empty.")
    end

    sh("xcrun simctl terminate #{udid} com.posix88.Voltly", log: false)
    # Give WidgetKit a beat to reload the timelines the app just invalidated.
    sleep(5)
  end

  desc "One-time setup for the Home Screen widget shot (06_widgets). Creates the dedicated"
  desc "simulator if needed, installs a seeded build, then walks you through placing the three"
  desc "Socket Buddy widgets on its Home Screen and records that you did. XCUITest cannot drive"
  desc "SpringBoard, so this single step is manual — everything after it is not."
  desc "Re-run it only if the device is deleted or the widget layout needs to change."
  lane :prepare_widget_device do
    ensure_ios27_sdk

    udid = widget_device_udid
    if udid.nil?
      UI.message("Creating simulator \"#{WIDGET_DEVICE_NAME}\"...")
      udid = sh("xcrun simctl create #{WIDGET_DEVICE_NAME.shellescape} #{WIDGET_DEVICE_TYPE} #{WIDGET_DEVICE_RUNTIME}", log: false).strip
    end

    boot_widget_device(udid: udid)
    build_widget_app(udid: udid)
    seed_widget_device(udid: udid)
    sh("xcrun simctl launch #{udid} com.posix88.Voltly -FASTLANE_SNAPSHOT YES", log: false)
    sh("xcrun simctl terminate #{udid} com.posix88.Voltly", log: false)

    UI.important("Now place the widgets on #{WIDGET_DEVICE_NAME}'s Home Screen, by hand, once:")
    UI.message("  1. Clear the first Home Screen page (remove the stock apps/widgets from it).")
    UI.message("  2. Long-press an empty spot -> the pill top-left -> Add Widget -> search \"Socket\".")
    UI.message("  3. Add, in this order: Next trip (large), My country (small), Favorite country (small).")
    UI.message("     Order matters: it puts the two small widgets on the top row and the large one below,")
    UI.message("     which is what the caption template frames (its bottom ~14% is cropped).")
    UI.message("  4. Leave the Home Screen showing that page.")

    unless UI.confirm("Are the three Socket Buddy widgets showing on the Home Screen now?")
      UI.user_error!("Aborted — nothing recorded. Re-run `fastlane prepare_widget_device` when the widgets are placed.")
    end

    sh("xcrun simctl spawn #{udid} defaults write #{WIDGET_MARKER_DOMAIN} #{WIDGET_MARKER_KEY} -bool YES", log: false)
    UI.success("#{WIDGET_DEVICE_NAME} is ready. `fastlane capture_widget_screenshots` can now run unattended.")
  end

  private_lane :build_widget_app do |options|
    udid = options[:udid]
    UI.message("Building #{SCHEME} for #{WIDGET_DEVICE_NAME}...")
    sh("xcodebuild -project #{File.expand_path('../WorldPlug.xcodeproj', __dir__).shellescape} " \
       "-scheme #{SCHEME} -configuration Debug -destination id=#{udid} " \
       "-derivedDataPath #{WIDGET_DERIVED_DATA.shellescape} -quiet build")

    app = File.join(WIDGET_DERIVED_DATA, "Build/Products/Debug-iphonesimulator/WorldPlug.app")
    UI.user_error!("Build produced no app at #{app}.") unless File.directory?(app)
    sh("xcrun simctl install #{udid} #{app.shellescape}", log: false)
  end

  desc "Capture the Home Screen widget shot (06_widgets) in every language, into"
  desc "Scripts/screenshots/raw/. Builds and installs a seeded build on the dedicated widget"
  desc "simulator, switches its system language per locale so the widgets themselves are"
  desc "localized, waits for the App Group mirror, cleans the status bar and screenshots it."
  desc "Requires a one-off `fastlane prepare_widget_device` first (widgets must already be on"
  desc "that device's Home Screen). Run `fastlane render_screenshots` afterward."
  lane :capture_widget_screenshots do |options|
    ensure_ios27_sdk

    udid = widget_device_udid
    # The marker lives in the device's own defaults, so the device has to be up to read it —
    # backticks, not `sh`, because a missing key is an expected answer here, not a lane failure.
    boot_widget_device(udid: udid) unless udid.nil?
    marker = udid && `xcrun simctl spawn #{udid} defaults read #{WIDGET_MARKER_DOMAIN} #{WIDGET_MARKER_KEY} 2>/dev/null`.strip

    if udid.nil? || marker != "1"
      message = "The widget capture device \"#{WIDGET_DEVICE_NAME}\" is not prepared. " \
                "Run `fastlane prepare_widget_device` once (it places the widgets on its Home Screen)."
      # `screenshots` passes optional:true so a missing device degrades to a warning instead of
      # taking the whole run down — the other five shots don't depend on it.
      if options[:optional]
        UI.important("Skipping the widget shot: #{message}")
        next
      end
      UI.user_error!(message)
    end

    build_widget_app(udid: udid)

    captured = []
    WIDGET_LANGUAGES.each do |language, locale|
      UI.message("Capturing the widget shot in #{language}...")
      # The widgets run in their own process and read the *device* language, so a per-app
      # -AppleLanguages launch argument (what `snapshot` uses) would not localize them.
      # `simctl spawn` needs the device booted, hence write-then-restart rather than the reverse.
      set_device_language(udid: udid, language: language)
      sh("xcrun simctl shutdown #{udid}", log: false)
      boot_widget_device(udid: udid)

      seed_widget_device(udid: udid)

      # Matches Snapfile's override_status_bar, which only applies to `snapshot`-driven runs.
      sh("xcrun simctl status_bar #{udid} override --time 9:41 --dataNetwork wifi --wifiMode active " \
         "--wifiBars 3 --cellularMode active --cellularBars 4 --batteryState charged --batteryLevel 100 " \
         "--operatorName ''", log: false)
      sleep(2)

      locale_directory = File.join(SCREENSHOT_RAW_DIRECTORY, locale)
      FileUtils.mkdir_p(locale_directory)
      destination = File.join(locale_directory, WIDGET_RAW_FILENAME)
      sh("xcrun simctl io #{udid} screenshot #{destination.shellescape}", log: false)

      dimensions = sh("sips -g pixelWidth -g pixelHeight #{destination.shellescape}", log: false)
      width = dimensions[/pixelWidth: (\d+)/, 1].to_i
      height = dimensions[/pixelHeight: (\d+)/, 1].to_i
      unless width == 1320 && height == 2868
        UI.user_error!("#{locale} widget capture is #{width}x#{height}, expected 1320x2868 — is #{WIDGET_DEVICE_NAME} still a 6.9\" iPhone?")
      end

      # English doubles as the flat raw/ fallback render-all.mjs uses for any locale that has no
      # capture of its own, exactly like capture_raw_screenshots does.
      FileUtils.cp(destination, File.join(SCREENSHOT_RAW_DIRECTORY, WIDGET_RAW_FILENAME)) if language.start_with?("en")
      captured << locale
    end

    # Leave the device in English so a later manual look at it isn't confusingly Italian.
    set_device_language(udid: udid, language: WIDGET_LANGUAGES.keys.first)
    sh("xcrun simctl shutdown #{udid}", log: false)

    UI.success("Captured the widget shot for: #{captured.join(', ')}. Run `fastlane render_screenshots` next.")
  end

  desc "Render every shot in Scripts/screenshots/captions.json (from raw captures already in"
  desc "Scripts/screenshots/raw/) and copy the results into AppStore/Screenshots/. Does NOT touch"
  desc "App Store Connect — run `fastlane upload_screenshots` (or `fastlane metadata`/`release`)"
  desc "afterward to upload them."
  desc "Includes both iPhone and iPad screenshots (iPad versions upscaled from iPhone raws)."
  desc "Doesn't capture raw screenshots itself: run `fastlane capture_raw_screenshots` first, or add"
  desc "PNGs to raw/ and an entry to captions.json by hand."
  lane :render_screenshots do
    screenshots_dir = File.expand_path("../Scripts/screenshots", __dir__)

    unless Dir.exist?(File.join(screenshots_dir, "node_modules"))
      UI.message("Installing screenshot renderer dependencies (first run only)...")
      sh("cd #{screenshots_dir.shellescape} && PUPPETEER_SKIP_DOWNLOAD=true npm install")
    end

    sh("cd #{screenshots_dir.shellescape} && node render-all.mjs")

    rendered_root = File.join(screenshots_dir, "out")
    destination_root = File.expand_path("../AppStore/Screenshots", __dir__)
    copied = 0

    # AppStore/Screenshots is generated output with device-specific directory structure
    # that deliver (fastlane's App Store Connect uploader) expects: Device/Locale/screenshot.png
    # Clean it completely so stale shots, invalid locales, or wrong device dirs can't survive.
    FileUtils.rm_rf(destination_root) if Dir.exist?(destination_root)
    FileUtils.mkdir_p(destination_root)

    # Map device names to their directory names for App Store Connect
    device_map = {
      "iphone" => "iPhone",
      "ipad" => "iPad"
    }

    # Copy screenshots organized by device, then locale (what deliver expects)
    Dir.glob(File.join(rendered_root, "*")).select { |entry| File.directory?(entry) }.each do |locale_dir|
      locale = File.basename(locale_dir)

      # iPhone screenshots: from render output root
      device_destination = File.join(destination_root, device_map["iphone"], locale)
      FileUtils.mkdir_p(device_destination)
      Dir.glob(File.join(locale_dir, "*.png")).each do |file|
        FileUtils.cp(file, device_destination)
        copied += 1
      end

      # iPad screenshots: from render output ipad/ subdirectory
      ipad_src_dir = File.join(locale_dir, "ipad")
      if Dir.exist?(ipad_src_dir)
        device_destination = File.join(destination_root, device_map["ipad"], locale)
        FileUtils.mkdir_p(device_destination)
        Dir.glob(File.join(ipad_src_dir, "*.png")).each do |file|
          FileUtils.cp(file, device_destination)
          copied += 1
        end
      end
    end

    UI.success("Copied #{copied} screenshot(s) into AppStore/Screenshots/. Run `fastlane upload_screenshots` (or `fastlane metadata`) to upload.")
    UI.message("Directory structure: iPhone/[locale] + iPad/[locale] — deliver will upload both device sets.")
  end
end
